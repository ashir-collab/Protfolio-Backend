generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ContactMessage {
  id        String        @id @default(uuid())
  name      String
  email     String
  message   String
  status    ContactStatus @default(UNREAD)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

enum ContactStatus {
  UNREAD
  READ
  REPLIED
  ARCHIVED
}